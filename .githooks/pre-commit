#!/usr/bin/env bash
# Быстрый ярус на каждый коммит: типы, тесты фронтенда, формат, контракт разметки.
# Держится в секундах намеренно — хук, который заставляет ждать, начинают обходить
# через --no-verify, и тогда он не ловит уже ничего.
exec bash "$(git rev-parse --show-toplevel)/tools/check.sh" --fast
