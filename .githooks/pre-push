#!/usr/bin/env bash
# Полный ярус на каждый push и БЛОКИРУЮЩИЙ: дальше этой точки код уезжает туда,
# откуда его забирают на сборку клиенту. GitHub Actions недоступны — если не
# проверить здесь, не проверит уже никто.
#
# Обход через --no-verify технически возможен, но считается инцидентом: значит,
# в репозиторий уехало непроверенное, и об этом надо сказать вслух.
set -e
ROOT="$(git rev-parse --show-toplevel)"
echo "pre-push: полный гейт (tools/check.sh --full). Это минуты — так и задумано."
exec bash "$ROOT/tools/check.sh" --full
